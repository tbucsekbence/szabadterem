rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Szuperadmin: igazolt e-mail cím alapján (functions/shared/rooms.js SUPERADMIN_EMAILS-szel egyezzen!)
    function isSuperadmin() {
      return signedIn()
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '').lower() in ['bucsek93@gmail.com'];
    }
    function isAdmin() {
      return isSuperadmin() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Foglaltsági térkép (csak azt mutatja, mely órák foglaltak) — bárki olvashatja,
    // írni csak a Cloud Functions tud.
    match /occupancy/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Foglalások: a tulajdonos és az admin olvashatja, írni csak a szerver tud.
    match /bookings/{bookingId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    function shortStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    // Felhasználói profil (Google bejelentkezés után kötelezően kitöltendő)
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'photoURL', 'role', 'school', 'styles',
             'groupSize', 'frequency', 'note', 'termsVersion', 'termsAcceptedAt', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && shortStr(request.resource.data, 'phone', 30)
        && shortStr(request.resource.data, 'email', 200)
        && shortStr(request.resource.data, 'photoURL', 500)
        && shortStr(request.resource.data, 'role', 20)
        && shortStr(request.resource.data, 'school', 150)
        && shortStr(request.resource.data, 'styles', 200)
        && shortStr(request.resource.data, 'frequency', 20)
        && shortStr(request.resource.data, 'note', 500)
        && shortStr(request.resource.data, 'termsVersion', 20)
        && (!('groupSize' in request.resource.data) || (request.resource.data.groupSize is int && request.resource.data.groupSize >= 1 && request.resource.data.groupSize <= 200));
      allow delete: if false;
    }

    // Kreditegyenleg és mozgásnapló — csak a szerver (Cloud Functions) írhatja.
    match /credits/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
      match /ledger/{entryId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow write: if false;
      }
    }

    // Adminok listája — mindenki csak a saját bejegyzését láthatja (admin-e).
    // Admint a Firebase konzolban lehet felvenni: admins/{uid} dokumentum.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Kapcsolati űrlap
    match /contactMessages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 3000
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
